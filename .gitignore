.venv/
.env
outputs/
__pycache__/
wandb/
logs/

# raw SFT data lives in SFT/data/raw and is tracked; everything else under data/ is not
data/
!SFT/data/
!RLAIF/data/
!RLVR/data/
!ABLATION/data/
!report/data/

# model dirs: keep only the final adapters (weights + config), skip every other checkpoint
**/model/*
!SFT/model/final_adapter/
!RLAIF/model/RLAIF_model/
!RLVR/model/RLVR_model/
!RLVR/model/RLVR_multiobjective_model/
RLAIF/model/RLAIF_model/optimizer.pt
RLAIF/model/RLAIF_model/ref/
RLAIF/model/RLAIF_model/*.pth
RLAIF/model/RLAIF_model/scheduler.pt
RLAIF/model/RLAIF_model/training_args.bin
RLAIF/model/RLAIF_model/trainer_state.json
RLVR/model/RLVR_model/ref/
RLVR/model/RLVR_model/training_args.bin
RLVR/model/RLVR_multiobjective_model/ref/
RLVR/model/RLVR_multiobjective_model/training_args.bin

# Intermediate render of the legacy Markdown report
report/REPORT.html

# LaTeX build intermediates; source, bibliography, review, and PDF are tracked
report/latex/main.aux
report/latex/main.bbl
report/latex/main.blg
report/latex/main.log
report/latex/main.out
